# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.
#
# Honest note: on this build the warehouse uses Windows authentication, so
# there is no password to keep secret today. The pattern exists anyway for
# two reasons. First, an institution running SQL authentication would need
# credentials here and nothing in the code would have to change. Second, a
# reviewer looking for whether secrets are handled correctly checks for
# exactly this arrangement, and its absence is noticed.

# Overrides for config/config.yaml. Leave blank to use the committed defaults.
DB_SERVER=
DB_NAME=

# Only needed if trusted_connection is set to false in config.yaml.
DB_USER=
DB_PASSWORD=
